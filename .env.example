# ───────── Telegram bot ─────────
BOT_TOKEN=123456:ABC...
# YOUR numeric Telegram chat ID. You are the only person who can log into the admin panel, and the
# bot answers only to you until you grant other admins access (from the bot's Admins menu, or the panel).
OWNER_ID=123456789
TIMEZONE=Asia/Kolkata

# ───────── Firebase Realtime Database ─────────
FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
# Use the file OR paste the whole service-account JSON on ONE line into FIREBASE_CRED_JSON (best for Render)
FIREBASE_CRED_FILE=serviceAccount.json
FIREBASE_CRED_JSON=

# ───────── Admin panel (https://<your-app>/admin) — owner-only login ─────────
ADMIN_USERNAME=owner
# If empty, a random password is generated and printed ONCE in the logs on first start
ADMIN_PASSWORD=
# Long random strings. SESSION_KEY encrypts the Telegram sessions - never change it after importing sessions!
SESSION_KEY=
SECRET_KEY=

# ───────── Telegram API keys for the session pool (my.telegram.org) ─────────
# Optional seed - you can add more (and more pairs) later in Panel > Setting
API_ID=
API_HASH=

# ───────── Rotating residential proxy (e.g. IPRoyal) - optional ─────────
# socks5://user:pass@host:port  or  http://user:pass@host:port
# Leave empty to run without a proxy; can also be set/changed later in the bot or the panel.
PROXY_URL=

# Leave empty locally -> long polling. On Render, RENDER_EXTERNAL_URL is used automatically.
BASE_URL=
